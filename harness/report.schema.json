{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RemoteCam Harness Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "report_version",
    "contract_version",
    "commit",
    "seed",
    "clock_start_millis",
    "environment",
    "scenarios",
    "verdict",
    "summary"
  ],
  "properties": {
    "report_version": {
      "const": 8
    },
    "contract_version": {
      "const": 1
    },
    "commit": {
      "type": "string",
      "pattern": "^(?:[a-fA-F0-9]{40}|[a-fA-F0-9]{64})$"
    },
    "seed": {
      "type": "integer",
      "minimum": 0,
      "maximum": 18446744073709551615
    },
    "clock_start_millis": {
      "type": "integer",
      "minimum": 0,
      "maximum": 18446744073709551615
    },
    "environment": {
      "$ref": "#/$defs/environment"
    },
    "scenarios": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "prefixItems": [
        {
          "$ref": "#/$defs/pairingHappyPath"
        },
        {
          "$ref": "#/$defs/pinMismatchAborts"
        },
        {
          "$ref": "#/$defs/qrExpiryRefused"
        },
        {
          "$ref": "#/$defs/tokenExpiryRefused"
        },
        {
          "$ref": "#/$defs/singleUseRefused"
        },
        {
          "$ref": "#/$defs/replayRefused"
        },
        {
          "$ref": "#/$defs/staleEpochDiscarded"
        },
        {
          "$ref": "#/$defs/clockBackwardsWindow"
        },
        {
          "$ref": "#/$defs/regenerationAfterRefusal"
        },
        {
          "$ref": "#/$defs/realMediaFrame"
        }
      ],
      "items": false
    },
    "verdict": {
      "enum": [
        "pass",
        "fail"
      ]
    },
    "summary": {
      "$ref": "#/$defs/summary"
    }
  },
  "$defs": {
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "os",
        "architecture",
        "rustc_version"
      ],
      "properties": {
        "os": {
          "type": "string",
          "minLength": 1
        },
        "architecture": {
          "type": "string",
          "minLength": 1
        },
        "rustc_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        }
      }
    },
    "scenarioBase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scenario",
        "outcome",
        "observed_state",
        "message_sequence",
        "state_trace",
        "frames",
        "resources",
        "verdict",
        "reason_code"
      ],
      "properties": {
        "scenario": {
          "type": "string"
        },
        "outcome": {
          "enum": [
            "accepted",
            "rejected",
            "timed_out"
          ]
        },
        "observed_state": {
          "enum": [
            "idle",
            "pairing_ready",
            "handshaking",
            "negotiating",
            "connected",
            "ended",
            "superseded"
          ]
        },
        "message_sequence": {
          "type": "array",
          "items": {
            "enum": [
              "pair",
              "paired",
              "offer",
              "answer"
            ]
          }
        },
        "state_trace": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/stateTransition"
          }
        },
        "frames": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/frameObservation"
          }
        },
        "late_frame_discarded": {
          "$ref": "#/$defs/discardedFrame"
        },
        "resources": {
          "$ref": "#/$defs/resources"
        },
        "verdict": {
          "enum": [
            "pass",
            "fail"
          ]
        },
        "reason_code": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "enum": [
                "invalid_qr_payload",
                "unsupported_qr_version",
                "qr_expired",
                "no_private_endpoint",
                "desktop_unreachable",
                "tls_handshake_failed",
                "certificate_pin_mismatch",
                "certificate_chain_rejected",
                "tls_version_unsupported",
                "token_invalid",
                "token_expired",
                "token_already_used",
                "source_address_not_private",
                "source_subnet_mismatch",
                "rate_limited",
                "listener_closed",
                "superseded",
                "protocol_violation",
                "internal_error",
                "ended_by_mobile",
                "ended_by_desktop",
                "timeout",
                "media_failure",
                "security_violation",
                "invalid_message",
                "unsupported_version"
              ]
            }
          ]
        },
        "issued_epochs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "protocol_violations": {
          "type": "integer",
          "minimum": 0
        },
        "real_media": {
          "$ref": "#/$defs/realMedia"
        }
      }
    },
    "pairingHappyPath": {
      "allOf": [
        {
          "$ref": "#/$defs/scenarioBase"
        },
        {
          "properties": {
            "scenario": {
              "const": "pairing-happy-path"
            },
            "outcome": {
              "const": "accepted"
            },
            "verdict": {
              "const": "pass"
            },
            "reason_code": {
              "const": null
            }
          }
        }
      ]
    },
    "pinMismatchAborts": {
      "allOf": [
        {
          "$ref": "#/$defs/scenarioBase"
        },
        {
          "properties": {
            "scenario": {
              "const": "pin-mismatch-aborts"
            },
            "outcome": {
              "const": "rejected"
            },
            "verdict": {
              "const": "pass"
            },
            "reason_code": {
              "const": "certificate_pin_mismatch"
            }
          }
        }
      ]
    },
    "stateTransition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from",
        "to",
        "at_millis"
      ],
      "properties": {
        "from": {
          "type": "string"
        },
        "to": {
          "type": "string"
        },
        "at_millis": {
          "type": "integer",
          "minimum": 0
        },
        "cause": {
          "type": "string"
        }
      }
    },
    "frameObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sequence",
        "at_millis"
      ],
      "properties": {
        "sequence": {
          "type": "integer",
          "minimum": 0
        },
        "at_millis": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "discardedFrame": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sequence",
        "at_millis",
        "reason"
      ],
      "properties": {
        "sequence": {
          "type": "integer",
          "minimum": 0
        },
        "at_millis": {
          "type": "integer",
          "minimum": 0
        },
        "reason": {
          "type": "string"
        }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "listeners",
        "connections",
        "media_ports",
        "tasks"
      ],
      "properties": {
        "listeners": {
          "$ref": "#/$defs/resourceCount"
        },
        "connections": {
          "$ref": "#/$defs/resourceCount"
        },
        "media_ports": {
          "$ref": "#/$defs/resourceCount"
        },
        "tasks": {
          "$ref": "#/$defs/resourceCount"
        }
      }
    },
    "resourceCount": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "created",
        "active_after_close"
      ],
      "properties": {
        "created": {
          "type": "integer",
          "minimum": 0
        },
        "active_after_close": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scenarios",
        "passed",
        "failed"
      ],
      "properties": {
        "scenarios": {
          "const": 10
        },
        "passed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10
        },
        "failed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10
        }
      }
    },
    "qrExpiryRefused": {
      "allOf": [
        {
          "$ref": "#/$defs/scenarioBase"
        },
        {
          "properties": {
            "scenario": {
              "const": "qr-expiry-refused"
            },
            "outcome": {
              "const": "rejected"
            },
            "verdict": {
              "const": "pass"
            },
            "reason_code": {
              "const": "qr_expired"
            }
          }
        }
      ]
    },
    "tokenExpiryRefused": {
      "allOf": [
        {
          "$ref": "#/$defs/scenarioBase"
        },
        {
          "properties": {
            "scenario": {
              "const": "token-expiry-refused"
            },
            "outcome": {
              "const": "rejected"
            },
            "verdict": {
              "const": "pass"
            },
            "reason_code": {
              "const": "token_expired"
            }
          }
        }
      ]
    },
    "singleUseRefused": {
      "allOf": [
        {
          "$ref": "#/$defs/scenarioBase"
        },
        {
          "properties": {
            "scenario": {
              "const": "single-use-refused"
            },
            "outcome": {
              "const": "rejected"
            },
            "verdict": {
              "const": "pass"
            },
            "reason_code": {
              "const": "superseded"
            }
          }
        }
      ]
    },
    "replayRefused": {
      "allOf": [
        {
          "$ref": "#/$defs/scenarioBase"
        },
        {
          "properties": {
            "scenario": {
              "const": "replay-refused"
            },
            "outcome": {
              "const": "rejected"
            },
            "verdict": {
              "const": "pass"
            },
            "reason_code": {
              "const": "token_already_used"
            }
          }
        }
      ]
    },
    "staleEpochDiscarded": {
      "allOf": [
        {
          "$ref": "#/$defs/scenarioBase"
        },
        {
          "properties": {
            "scenario": {
              "const": "stale-epoch-discarded"
            },
            "outcome": {
              "const": "accepted"
            },
            "verdict": {
              "const": "pass"
            },
            "reason_code": {
              "const": null
            }
          }
        }
      ]
    },
    "clockBackwardsWindow": {
      "allOf": [
        {
          "$ref": "#/$defs/scenarioBase"
        },
        {
          "properties": {
            "scenario": {
              "const": "clock-backwards-window"
            },
            "outcome": {
              "const": "rejected"
            },
            "verdict": {
              "const": "pass"
            },
            "reason_code": {
              "const": "token_expired"
            }
          }
        }
      ]
    },
    "regenerationAfterRefusal": {
      "allOf": [
        {
          "$ref": "#/$defs/scenarioBase"
        },
        {
          "properties": {
            "scenario": {
              "const": "regeneration-after-refusal"
            },
            "outcome": {
              "const": "accepted"
            },
            "verdict": {
              "const": "pass"
            },
            "reason_code": {
              "const": null
            }
          }
        }
      ]
    },
    "realMedia": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pixel_format",
        "width",
        "height",
        "frames_decoded",
        "frames_dropped",
        "ring_slots",
        "receive_only",
        "loss_recovery",
        "audio_continuity",
        "av_sync"
      ],
      "properties": {
        "pixel_format": {
          "const": "nv12"
        },
        "width": {
          "type": "integer",
          "minimum": 2,
          "multipleOf": 2
        },
        "height": {
          "type": "integer",
          "minimum": 2,
          "multipleOf": 2
        },
        "frames_decoded": {
          "type": "integer",
          "minimum": 1
        },
        "frames_dropped": {
          "type": "integer",
          "minimum": 0
        },
        "ring_slots": {
          "const": 3
        },
        "receive_only": {
          "const": true
        },
        "loss_recovery": {
          "$ref": "#/$defs/lossRecovery"
        },
        "audio_continuity": {
          "$ref": "#/$defs/audioContinuity"
        },
        "av_sync": {
          "$ref": "#/$defs/avSync"
        }
      }
    },
    "avSync": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nominal",
        "audio_absent",
        "drift_limit"
      ],
      "properties": {
        "nominal": {
          "$ref": "#/$defs/avNominalRun"
        },
        "audio_absent": {
          "$ref": "#/$defs/avAudioAbsentRun"
        },
        "drift_limit": {
          "$ref": "#/$defs/avDriftLimitRun"
        }
      }
    },
    "avNominalRun": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile",
        "duration_seconds",
        "mode",
        "video_frames_sent",
        "presented",
        "measured",
        "skipped",
        "over_target",
        "max_drift_micros",
        "max_frame_offset_micros"
      ],
      "properties": {
        "profile": {
          "const": "nominal"
        },
        "duration_seconds": {
          "type": "integer",
          "minimum": 3600
        },
        "mode": {
          "const": "audio_master"
        },
        "video_frames_sent": {
          "type": "integer",
          "minimum": 1
        },
        "presented": {
          "type": "integer",
          "minimum": 1
        },
        "measured": {
          "type": "integer",
          "minimum": 1
        },
        "skipped": {
          "type": "integer",
          "minimum": 0
        },
        "over_target": {
          "const": 0
        },
        "max_drift_micros": {
          "type": "integer",
          "minimum": 0,
          "maximum": 20000
        },
        "max_frame_offset_micros": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "avAudioAbsentRun": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile",
        "duration_seconds",
        "mode",
        "video_frames_sent",
        "presented",
        "measured",
        "skipped",
        "over_target",
        "max_drift_micros",
        "max_frame_offset_micros"
      ],
      "properties": {
        "profile": {
          "const": "nominal"
        },
        "duration_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "mode": {
          "const": "video_free"
        },
        "video_frames_sent": {
          "type": "integer",
          "minimum": 1
        },
        "presented": {
          "type": "integer",
          "minimum": 1
        },
        "measured": {
          "const": 0
        },
        "skipped": {
          "type": "integer",
          "minimum": 0
        },
        "over_target": {
          "const": 0
        },
        "max_drift_micros": {
          "const": 0
        },
        "max_frame_offset_micros": {
          "const": 0
        }
      }
    },
    "avDriftLimitRun": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "injected_video_delay_millis",
        "stopped_at_millis",
        "max_drift_micros",
        "session_state",
        "close_reason",
        "close_before_release"
      ],
      "properties": {
        "injected_video_delay_millis": {
          "type": "integer",
          "minimum": 101
        },
        "stopped_at_millis": {
          "type": "integer",
          "minimum": 0
        },
        "max_drift_micros": {
          "type": "integer",
          "minimum": 100001
        },
        "session_state": {
          "const": "ended"
        },
        "close_reason": {
          "const": "media_failure"
        },
        "close_before_release": {
          "const": true
        }
      }
    },
    "audioContinuity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile",
        "duration_seconds",
        "frames_sent",
        "frames_played",
        "decoded_frames",
        "concealed_frames",
        "silent_frames",
        "late_packets",
        "underrun_dropouts",
        "silence_dropouts",
        "longest_underrun_millis",
        "longest_silent_run_millis"
      ],
      "properties": {
        "profile": {
          "const": "nominal"
        },
        "duration_seconds": {
          "type": "integer",
          "minimum": 600
        },
        "frames_sent": {
          "type": "integer",
          "minimum": 1
        },
        "frames_played": {
          "type": "integer",
          "minimum": 1
        },
        "decoded_frames": {
          "type": "integer",
          "minimum": 1
        },
        "concealed_frames": {
          "type": "integer",
          "minimum": 0
        },
        "silent_frames": {
          "type": "integer",
          "minimum": 0
        },
        "late_packets": {
          "type": "integer",
          "minimum": 0
        },
        "underrun_dropouts": {
          "const": 0
        },
        "silence_dropouts": {
          "const": 0
        },
        "longest_underrun_millis": {
          "type": "integer",
          "minimum": 0,
          "exclusiveMaximum": 50
        },
        "longest_silent_run_millis": {
          "type": "integer",
          "minimum": 0,
          "exclusiveMaximum": 50
        }
      }
    },
    "lossRecovery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile",
        "duration_seconds",
        "packets_sent",
        "packets_lost",
        "packets_late",
        "nack_requests",
        "nacked_packets",
        "plis",
        "fresh_frames",
        "repeated_frames",
        "absent_ticks",
        "longest_without_fresh_millis",
        "jitter_depth_micros"
      ],
      "properties": {
        "profile": {
          "const": "nominal"
        },
        "duration_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "packets_sent": {
          "type": "integer",
          "minimum": 1
        },
        "packets_lost": {
          "type": "integer",
          "minimum": 0
        },
        "packets_late": {
          "type": "integer",
          "minimum": 0
        },
        "nack_requests": {
          "type": "integer",
          "minimum": 1
        },
        "nacked_packets": {
          "type": "integer",
          "minimum": 1
        },
        "plis": {
          "type": "integer",
          "minimum": 0
        },
        "fresh_frames": {
          "type": "integer",
          "minimum": 1
        },
        "repeated_frames": {
          "type": "integer",
          "minimum": 0
        },
        "absent_ticks": {
          "const": 0
        },
        "longest_without_fresh_millis": {
          "type": "integer",
          "minimum": 0,
          "exclusiveMaximum": 2000
        },
        "jitter_depth_micros": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "realMediaFrame": {
      "allOf": [
        {
          "$ref": "#/$defs/scenarioBase"
        },
        {
          "required": [
            "real_media"
          ],
          "properties": {
            "scenario": {
              "const": "real-media-frame"
            },
            "outcome": {
              "const": "accepted"
            },
            "verdict": {
              "const": "pass"
            },
            "reason_code": {
              "const": null
            }
          }
        }
      ]
    }
  }
}
