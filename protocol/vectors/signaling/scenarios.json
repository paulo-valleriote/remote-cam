{
  "version": 1,
  "description": "Pinned signaling and pairing scenarios. kind=message cases are executed by both protocol consumers; kind=handshake cases are executed by the pairing harness.",
  "scenarios": [
    {
      "id": "msg-pair-valid",
      "kind": "message",
      "description": "A valid pair message.",
      "message": {
        "version": 1,
        "type": "pair",
        "token": "000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f",
        "dtls_fingerprint": "9f2c1e4b6a8d0f3c5e7a9b1d2f4c6e8a0b2d4f6a8c0e2b4d6f8a0c1e3b5d7f9a",
        "limits": {
          "max_width": 1280,
          "max_height": 720,
          "max_frame_rate": 30,
          "max_video_bitrate_kbps": 2500,
          "max_audio_bitrate_kbps": 48
        }
      },
      "expected_outcome": "accept",
      "expected_reason_code": null
    },
    {
      "id": "msg-paired-valid",
      "kind": "message",
      "description": "A valid paired message.",
      "message": {
        "version": 1,
        "type": "paired",
        "session_id": "00112233445566778899aabbccddeeff",
        "epoch": 7,
        "dtls_fingerprint": "9f2c1e4b6a8d0f3c5e7a9b1d2f4c6e8a0b2d4f6a8c0e2b4d6f8a0c1e3b5d7f9a",
        "accepted_limits": {
          "max_width": 1280,
          "max_height": 720,
          "max_frame_rate": 30
        }
      },
      "expected_outcome": "accept",
      "expected_reason_code": null
    },
    {
      "id": "msg-offer-valid",
      "kind": "message",
      "description": "A valid SDP offer.",
      "message": {
        "version": 1,
        "type": "offer",
        "epoch": 7,
        "sdp": "v=0\r\no=- 1 1 IN IP4 0.0.0.0\r\nm=video 9 UDP/TLS/RTP/SAVPF 96\r\n"
      },
      "expected_outcome": "accept",
      "expected_reason_code": null
    },
    {
      "id": "msg-answer-valid",
      "kind": "message",
      "description": "A valid recvonly SDP answer.",
      "message": {
        "version": 1,
        "type": "answer",
        "epoch": 7,
        "sdp": "v=0\r\no=- 1 1 IN IP4 0.0.0.0\r\nm=video 9 UDP/TLS/RTP/SAVPF 96\r\na=recvonly\r\n"
      },
      "expected_outcome": "accept",
      "expected_reason_code": null
    },
    {
      "id": "msg-ice-valid",
      "kind": "message",
      "description": "A valid ICE candidate list.",
      "message": {
        "version": 1,
        "type": "ice",
        "epoch": 7,
        "candidates": [
          {
            "address": "192.168.1.42",
            "port": 51234,
            "component": 1,
            "protocol": "udp"
          },
          {
            "address": "192.168.1.42",
            "port": 51235,
            "component": 2,
            "protocol": "udp"
          }
        ]
      },
      "expected_outcome": "accept",
      "expected_reason_code": null
    },
    {
      "id": "msg-stats-valid",
      "kind": "message",
      "description": "A valid stats message.",
      "message": {
        "version": 1,
        "type": "stats",
        "fps": 30,
        "video_bitrate_kbps": 2500,
        "rtt_ms": 12.4,
        "loss_pct": 0.0,
        "thermal_status": "none"
      },
      "expected_outcome": "accept",
      "expected_reason_code": null
    },
    {
      "id": "msg-close-valid",
      "kind": "message",
      "description": "A valid session close.",
      "message": {
        "version": 1,
        "type": "close",
        "code": "ended_by_mobile"
      },
      "expected_outcome": "accept",
      "expected_reason_code": null
    },
    {
      "id": "msg-error-valid",
      "kind": "message",
      "description": "A valid signaling error.",
      "message": {
        "version": 1,
        "type": "error",
        "code": "invalid_message"
      },
      "expected_outcome": "accept",
      "expected_reason_code": null
    },
    {
      "id": "msg-ping-valid",
      "kind": "message",
      "description": "A valid ping.",
      "message": {
        "version": 1,
        "type": "ping"
      },
      "expected_outcome": "accept",
      "expected_reason_code": null
    },
    {
      "id": "msg-pong-valid",
      "kind": "message",
      "description": "A valid pong.",
      "message": {
        "version": 1,
        "type": "pong"
      },
      "expected_outcome": "accept",
      "expected_reason_code": null
    },
    {
      "id": "msg-missing-version",
      "kind": "message",
      "description": "version is required.",
      "message": {
        "type": "ping"
      },
      "expected_outcome": "reject",
      "expected_reason_code": "invalid_message"
    },
    {
      "id": "msg-missing-type",
      "kind": "message",
      "description": "type is required.",
      "message": {
        "version": 1
      },
      "expected_outcome": "reject",
      "expected_reason_code": "invalid_message"
    },
    {
      "id": "msg-version-zero",
      "kind": "message",
      "description": "Version 0 is below the supported minimum.",
      "message": {
        "version": 0,
        "type": "ping"
      },
      "expected_outcome": "reject",
      "expected_reason_code": "invalid_message"
    },
    {
      "id": "msg-version-two",
      "kind": "message",
      "description": "A newer protocol version is rejected with its own code, not silently accepted.",
      "message": {
        "version": 2,
        "type": "ping"
      },
      "expected_outcome": "reject",
      "expected_reason_code": "unsupported_version"
    },
    {
      "id": "msg-version-wrong-type",
      "kind": "message",
      "description": "A string version does not satisfy the schema.",
      "message": {
        "version": "1",
        "type": "ping"
      },
      "expected_outcome": "reject",
      "expected_reason_code": "invalid_message"
    },
    {
      "id": "msg-type-unknown",
      "kind": "message",
      "description": "The type enumeration is closed.",
      "message": {
        "version": 1,
        "type": "hello"
      },
      "expected_outcome": "reject",
      "expected_reason_code": "invalid_message"
    },
    {
      "id": "msg-type-wrong-type",
      "kind": "message",
      "description": "A non-string type does not satisfy the schema.",
      "message": {
        "version": 1,
        "type": 1
      },
      "expected_outcome": "reject",
      "expected_reason_code": "invalid_message"
    },
    {
